# Split Brain configuration. `./sb up` copies this to .env the first time.

# ---- AI bot (required: Ada is a real LLM) --------------------------------
# Provider wire format: "anthropic" or "openai-compatible"
# (openai-compatible covers OpenAI, OpenRouter, Gemini's OpenAI endpoint, Ollama, LM Studio…)
LLM_PROVIDER=
# API key. Leave empty for a local Ollama / LM Studio server.
LLM_API_KEY=
# The model id exactly as your provider lists it. There is no default on purpose.
LLM_MODEL=
# openai-compatible only, e.g.
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   https://generativelanguage.googleapis.com/v1beta/openai
#   http://host.docker.internal:11434/v1   (Ollama on your machine, free)
LLM_BASE_URL=
# Spend guards
BOT_MAX_CALLS=40
BOT_MAX_OUTPUT_TOKENS=4096

# ---- Relay ---------------------------------------------------------------
SB_PORT=8080
# Leave empty to use the built-in default
IDLE_TIMEOUT_MS=

# ---- Submission -----------------------------------------------------------
# Your personal submission link from your invitation email. ./sb submit asks
# for it the first time and saves it here.
SUBMIT_URL=
